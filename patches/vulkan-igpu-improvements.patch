+// GGML_OP_CONCAT + GGML_OP_SSM_CONV + GGML_OP_UNARY(SILU) + GGML_OP_CPY: the conv state update of a recurrent layer
+// (concat of the conv state and the new qkv, ssm_conv + silu on it, and its newest columns copied into the cache)
+struct test_ssm_conv_concat_cpy : public test_case {
+    const int64_t d_conv;
+    const int64_t n_channels;
+    const int64_t n_tokens;
+    const int64_t n_seqs;
+    const bool    alias; // the conv state is read from the cache rows the new one is written to
+
+    ggml_tensor * cpy_node  = nullptr;
+    ggml_tensor * silu_node = nullptr;
+
+    std::string vars() override {
+        return VARS_TO_STR5(d_conv, n_channels, n_tokens, n_seqs, alias);
+    }
+
+    test_ssm_conv_concat_cpy(int64_t d_conv = 4, int64_t n_channels = 1536, int64_t n_tokens = 1, int64_t n_seqs = 1,
+            bool alias = true)
+        : d_conv(d_conv), n_channels(n_channels), n_tokens(n_tokens), n_seqs(n_seqs), alias(alias) {}
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "SSM_CONV_CONCAT_CPY";
+    }
+
+    bool run_whole_graph() override { return true; }
+    std::vector<ggml_tensor *> fusion_test_nodes() override { return { cpy_node, silu_node }; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t row_size = (d_conv - 1) * n_channels;
+        const int64_t mem_size = n_seqs + 2;
+        const int64_t kv_head  = 1;
+
+        // recurrent cache: one row of d_conv-1 values per channel and sequence slot
+        ggml_tensor * cache = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, row_size, mem_size);
+        ggml_set_name(cache, "cache");
+        ggml_tensor * update = ggml_view_2d(ctx, cache, row_size, n_seqs, cache->nb[1], kv_head * cache->nb[1]);
+
+        ggml_tensor * state2d = update;
+        if (alias) {
+            state2d = ggml_view_2d(ctx, cache, row_size, n_seqs, cache->nb[1], kv_head * cache->nb[1]);
+        } else {
+            state2d = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, row_size, n_seqs);
+            ggml_set_name(state2d, "state");
+        }
+        ggml_tensor * state = ggml_reshape_3d(ctx, state2d, d_conv - 1, n_channels, n_seqs);
+
+        ggml_tensor * qkv = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_channels, n_tokens, n_seqs);
+        ggml_set_name(qkv, "qkv");
+        ggml_tensor * weight = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d_conv, n_channels);
+        ggml_set_name(weight, "weight");
+
+        ggml_tensor * concat = ggml_concat(ctx, state, ggml_transpose(ctx, qkv), 0);
+
+        ggml_tensor * last = ggml_view_3d(ctx, concat, d_conv - 1, n_channels, n_seqs,
+                concat->nb[1], concat->nb[2], n_tokens * ggml_element_size(concat));
+        ggml_tensor * cpy = ggml_cpy(ctx, last, update);
+        ggml_set_name(cpy, "conv_state_update");
+        cpy_node = cpy;
+
+        ggml_tensor * silu = ggml_silu(ctx, ggml_ssm_conv(ctx, concat, weight));
+        ggml_set_name(silu, "conv_output_silu");
+        silu_node = silu;
+
+        // one consumer of both, reading the cpy first like the models that expand it while building the layer,
+        // so that neither is a graph output and the nodes of the fusion stay together in the graph
+        ggml_tensor * out = ggml_concat(ctx,
+                ggml_reshape_1d(ctx, cpy,  ggml_nelements(cpy)),
+                ggml_reshape_1d(ctx, silu, ggml_nelements(silu)), 0);
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
