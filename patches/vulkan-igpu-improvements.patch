+    }
+    if (silu->ne[0] != nr || silu->ne[1] != qkv->ne[0] || silu->ne[2] != n_s || silu->ne[3] != 1 || !ggml_is_contiguous(silu)) {
+        return false;
+    }
+    if (buffers) {
+        for (const ggml_tensor * t : { state, qkv, weight, cache, silu }) {
