+// Fuse gated_delta_net with the cpy that copies its final state (snapshots) into the recurrent cache.
+static bool ggml_vk_can_fuse_gated_delta_net_cpy(ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph,
+                                                 int node_idx) {
+    const ggml_tensor * gdn  = cgraph->nodes[node_idx + 0];
+    const ggml_tensor * src  = cgraph->nodes[node_idx + 1]; // view of the snapshot tail of gdn
+    const ggml_tensor * cpy  = cgraph->nodes[node_idx + 3];
+    const ggml_tensor * dst  = cpy->src[1];                 // recurrent cache view
+
+    // The shader skips the snapshot tail, so neither gdn nor the cpy may be a graph output.
+    if (gdn->type != GGML_TYPE_F32 || (gdn->flags & GGML_TENSOR_FLAG_OUTPUT) || (cpy->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+
+    const ggml_tensor * src_v = gdn->src[2];
+    const int64_t S_v       = src_v->ne[0];
+    const int64_t H         = src_v->ne[1];
+    const int64_t n_tokens  = src_v->ne[2];
+    const int64_t n_seqs    = src_v->ne[3];
+    const int64_t D         = S_v * S_v * H;
+    const int64_t K         = ggml_get_op_params_i32(gdn, 0);
+    const int64_t n_written = std::min<int64_t>(n_tokens, K);
+
+    // The snapshot tail starts right after the attention scores.
+    if (src->view_offs != ggml_row_size(GGML_TYPE_F32, S_v * H * n_tokens * n_seqs) || !ggml_is_contiguous(src)) {
+        return false;
+    }
+
+    // The cache view is [D, n_seqs, n_written] with the per-seq stride the shader assumes.
+    const int64_t expected_ne[GGML_MAX_DIMS] = { D, n_seqs, n_written, 1 };
+    for (int i = 0; i < GGML_MAX_DIMS; ++i) {
+        if (dst->ne[i] != expected_ne[i]) {
+            return false;
+        }
+    }
+    return dst->type == GGML_TYPE_F32 && dst->buffer != nullptr &&
+           dst->nb[0] == sizeof(float) && dst->nb[1] == (size_t) D * sizeof(float) &&
+           get_misalign_bytes(ctx, dst) == 0;
+}
+
+// The conv state update of a recurrent layer: concat of the conv state and the new qkv, a view of its newest
+// kernel_size-1 columns copied into the recurrent cache, and the ssm_conv + silu reading the concat.
+static constexpr ggml_op ssm_conv_concat_cpy_ops[6] = {
+    GGML_OP_CONCAT, GGML_OP_VIEW, GGML_OP_VIEW, GGML_OP_CPY, GGML_OP_SSM_CONV, GGML_OP_UNARY,
+};
+
+// Finds the six nodes around the CONCAT at concat_idx, in the order of ssm_conv_concat_cpy_ops. The models do not
+// build them adjacent. Nodes already scheduled (used) are not eligible.
+static bool ggml_vk_find_ssm_conv_concat_cpy(const struct ggml_cgraph * cgraph, int concat_idx,
+                                             const std::vector<bool> * used, int idx[6]) {
+    const ggml_tensor * concat = cgraph->nodes[concat_idx];
+    if (concat->op != GGML_OP_CONCAT) {
+        return false;
+    }
+    std::fill_n(idx, 6, -1);
+    idx[0] = concat_idx;
+
+    auto const & free_node = [&](int j) { return !used || !(*used)[j]; };
+
+    for (int j = concat_idx + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * node = cgraph->nodes[j];
+        if (!free_node(j)) {
+            continue;
+        }
+        if (node->op == GGML_OP_VIEW && node->src[0] == concat && idx[1] < 0) {
+            idx[1] = j;
+        } else if (node->op == GGML_OP_SSM_CONV && node->src[0] == concat && idx[4] < 0) {
+            idx[4] = j;
+        }
+    }
+    if (idx[1] < 0 || idx[4] < 0) {
+        return false;
+    }
+    for (int j = idx[1] + 1; j < cgraph->n_nodes && idx[3] < 0; ++j) {
+        const ggml_tensor * node = cgraph->nodes[j];
+        if (free_node(j) && node->op == GGML_OP_CPY && node->src[0] == cgraph->nodes[idx[1]]) {
+            idx[3] = j;
+        }
+    }
+    for (int j = idx[4] + 1; j < cgraph->n_nodes && idx[5] < 0; ++j) {
+        const ggml_tensor * node = cgraph->nodes[j];
+        if (free_node(j) && node->op == GGML_OP_UNARY && node->src[0] == cgraph->nodes[idx[4]]) {
+            idx[5] = j;
+        }
+    }
+    if (idx[3] < 0 || idx[5] < 0) {
+        return false;
+    }
+    // the view of the recurrent cache the cpy writes
+    for (int j = concat_idx + 1; j < cgraph->n_nodes && idx[2] < 0; ++j) {
+        if (free_node(j) && cgraph->nodes[j] == cgraph->nodes[idx[3]]->src[1]) {
+            idx[2] = j;
+        }
+    }
+    return idx[2] >= 0;
+}
