+        return 0;
+    }
+    for (int j = node_idx + 1; j < idx[5]; ++j) {
+        const ggml_tensor * node = cgraph->nodes[j];
+        const bool member = j == idx[1] || j == idx[2] || j == idx[3] || j == idx[4];
+        if (!member && node->op != GGML_OP_NONE && node->op != GGML_OP_RESHAPE && node->op != GGML_OP_TRANSPOSE &&
