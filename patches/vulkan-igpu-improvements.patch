+    const ggml_tensor * state  = concat->src[0];
+    const ggml_tensor * qkv    = concat->src[1];
+    const ggml_tensor * weight = conv->src[1];
+    if (!state || !qkv || !weight) {
+        return false;
+    }
+
+    // The shader handles one token per sequence (the cache may alias the conv state, so every channel is
+    // read and written by a single invocation) and the kernel width its pipeline is specialized for.
+    const int64_t nc  = weight->ne[0];
+    const int64_t nr  = state->ne[1];
+    const int64_t n_s = state->ne[2];
+    if (nc != 4 || qkv->ne[0] != 1 || state->ne[0] != nc - 1 || qkv->ne[1] != nr || qkv->ne[2] != n_s ||
+        weight->ne[1] != nr || state->ne[3] != 1 || qkv->ne[3] != 1 || weight->ne[2] != 1) {
+        return false;
+    }
