+// buffers is false while the graph is being reordered, before its tensors have buffers
+static bool ggml_vk_can_fuse_ssm_conv_concat_cpy(ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, const int idx[6], bool buffers) {
+    // the concat, its view and the ssm_conv are elided; the cache view, the cpy and the silu are outputs
+    const int outputs[3] = { idx[2], idx[3], idx[5] };
+    if (!ggml_can_fuse_subgraph_ext(cgraph, idx, 6, ssm_conv_concat_cpy_ops, outputs, 3)) {
+        return false;
+    }
+
+    const ggml_tensor * concat = cgraph->nodes[idx[0]];
+    const ggml_tensor * last   = cgraph->nodes[idx[1]]; // newest kernel_size-1 columns of the concat
+    const ggml_tensor * cache  = cgraph->nodes[idx[2]]; // view of the recurrent cache
+    const ggml_tensor * cpy    = cgraph->nodes[idx[3]];
+    const ggml_tensor * conv   = cgraph->nodes[idx[4]];
+    const ggml_tensor * silu   = cgraph->nodes[idx[5]];
+
+    if (last->src[0] != concat || cpy->src[0] != last || cpy->src[1] != cache ||
+        conv->src[0] != concat || silu->src[0] != conv || ggml_get_unary_op(silu) != GGML_UNARY_OP_SILU) {
+        return false;
+    }
