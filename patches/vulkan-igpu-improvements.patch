+static int ggml_vk_fuse_ssm_conv_concat_cpy(ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx, int idx[6]) {
+    if (cgraph->nodes[node_idx]->op != GGML_OP_CONCAT || !ggml_vk_find_ssm_conv_concat_cpy(cgraph, node_idx, nullptr, idx)) {
