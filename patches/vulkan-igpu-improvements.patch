+    if (state->nb[0] != sizeof(float) || state->nb[1] != (nc - 1) * sizeof(float) || state->nb[2] % sizeof(float) != 0 ||
+        qkv->nb[0] % sizeof(float) != 0 || qkv->nb[1] % sizeof(float) != 0 || qkv->nb[2] % sizeof(float) != 0 ||
+        weight->nb[0] != sizeof(float) || weight->nb[1] % sizeof(float) != 0) {
+        return false;
+    }
+    // the new conv state is the last nc-1 columns of the concat of each channel
+    if (last->ne[0] != nc - 1 || last->ne[1] != nr || last->ne[2] != n_s || last->ne[3] != 1 ||
+        last->view_offs != sizeof(float) * (size_t) qkv->ne[0] ||
+        last->nb[1] != concat->nb[1] || last->nb[2] != concat->nb[2]) {
+        return false;
+    }
+    // ... and goes to one row of nr*(nc-1) values per sequence of the cache view
+    if (cache->ne[0] != (nc - 1) * nr || cache->ne[1] != n_s || cache->ne[2] != 1 || cache->ne[3] != 1 ||
