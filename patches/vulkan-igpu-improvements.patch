+bool llama_memory_recurrent_context::s_copy_is_identity(uint32_t n_seqs) const {
+    // the reserve graph, rollback snapshots (s_copy() adds a group offset), cleared states (rs_z >= 0)
+    // and extra cells between the ubatch states and n_rs all need the regular gather
+    if (is_full || !mem->state_alias_ok || mem->n_rs_seq != 0 || mem->rs_z >= 0 || mem->n != n_seqs) {
+        return false;
+    }
+
+    for (uint32_t i = 0; i < n_seqs; ++i) {
+        const uint32_t cell_idx = mem->head + i;
+        if (mem->cells[cell_idx].src0 != (int32_t) cell_idx) {
+            return false;
+        }
+    }
+
+    return true;
